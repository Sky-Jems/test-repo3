<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:POS.Views"
             x:Class="pos.MainPage"
             BackgroundColor="{StaticResource CoreBackground}">

    <Grid
        Grid.Row="{OnPlatform iOS=1, Default=0}"
        ColumnDefinitions="{OnIdiom Phone='*', Default='650,*'}"
        RowDefinitions="*"
        ColumnSpacing="12"
        Margin="12,0,0,0">

        <!-- Cart panel-->
        <v:CartPanel
            BackgroundColor="{StaticResource CoreForeground}"/>

        <!-- Widget panel -->
        <ContentView x:Name="DynamicContentView"
                Grid.Column="{OnIdiom Phone=0, Default=1}"
                Grid.Row="0"
                BackgroundColor="{StaticResource CoreForeground}"/>
    </Grid>

</ContentPage>
