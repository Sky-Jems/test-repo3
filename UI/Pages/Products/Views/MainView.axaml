<UserControl
    x:Class="Pos.Pages.Products.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pos.Pages.Products"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="{StaticResource SemiThicknessSuperLoose}"
    x:DataType="app:MainViewModel"
    mc:Ignorable="d">

    <DockPanel VerticalSpacing="{StaticResource SemiSpacingLoose}">
        <Grid
            Height="{StaticResource SemiHeightControlLarge}"
            ColumnDefinitions="* auto"
            DockPanel.Dock="Top">
            <Label
                Grid.Column="0"
                VerticalContentAlignment="Center"
                Classes="H2"
                Content="{Binding ProductCountText}"
                Theme="{StaticResource TitleLabel}" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{StaticResource SemiSpacingBase}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SemiSpacingTight}">
                    <TextBox
                        Name="search_box"
                        Grid.Column="0"
                        MinWidth="200"
                        Classes="Large Bordered clearButton"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Watermark="Search...">
                        <TextBox.InnerLeftContent>
                            <PathIcon
                                Height="16"
                                Data="{StaticResource SemiIconSearch}"
                                Theme="{StaticResource InnerPathIcon}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        Classes="Large Bordered"
                        ItemsSource="{Binding ComboBoxItems}"
                        PlaceholderText="Select category"
                        SelectedItem="{Binding SelectedComboBoxItem, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button
                    Classes="Large"
                    Command="{Binding NavigateToCreateProduct}"
                    CommandParameter="{Binding}"
                    Theme="{StaticResource SolidButton}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SemiSpacingTight}">
                        <PathIcon Data="{StaticResource SemiIconPlus}" Theme="{StaticResource InnerPathIcon}" />
                        <AccessText Text="Add Product" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <DataGrid
            CanUserResizeColumns="False"
            CanUserSortColumns="True"
            ClipToBounds="False"
            GridLinesVisibility="None"
            ItemsSource="{Binding Products}">
            <DataGrid.Columns>
                <!-- <DataGridTemplateColumn Width="75">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <DataGridTemplateColumn Width="*" Header="Product Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="Description">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding CategoryNames}"
                    Header="Category" />

                <DataGridTextColumn Width="*" Header="Price">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Price" StringFormat="₱ {0}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="none" Tag="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Classes="Tertiary"
                                    Click="EditButton_Click"
                                    Tag="{Binding}"
                                    Theme="{StaticResource BorderlessButton}">
                                    <PathIcon
                                        Height="16"
                                        Data="{StaticResource SemiIconEdit}"
                                        Theme="{StaticResource InnerPathIcon}" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Classes="Danger"
                                    Click="DeleteButton_Click"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding Id}"
                                    Theme="{StaticResource BorderlessButton}">
                                    <PathIcon
                                        Height="16"
                                        Data="{StaticResource SemiIconDelete}"
                                        Theme="{StaticResource InnerPathIcon}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
