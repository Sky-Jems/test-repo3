<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    xmlns:vm="using:Pos.Pages.Home.Views.Categories"
    x:Class="Pos.Pages.Home.Views.Categories.Categories"
    x:DataType="vm:CategoriesViewModel"
    xmlns:controls="using:Pos.Controls"
    xmlns:tempButton="using:Pos.Controls.TempButton"
    >
    <Border Padding="24" Background="#101C24">
        <StackPanel Spacing="12">
            <Label
                Foreground="#FFE9C1"
                FontSize="34"
                Padding="0"
                Margin="0 0 0 20">
                CATEGORY
            </Label>

            <Label FontSize="24" Padding="0" Foreground="#FFE9C1">
                Regular
            </Label>

            <ItemsRepeater
                ItemsSource="{Binding Regulars}"
                VerticalAlignment="Top"
                Margin="0 0 0 20">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="160"
                        MinItemHeight="100"
                        ItemsStretch="Uniform"
                        MinRowSpacing="16"
                        MinColumnSpacing="16"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <controls:CategoryCard Category="{Binding}" CategoryCommand="{Binding $parent[ItemsRepeater].((vm:CategoriesViewModel)DataContext).CategoryCardClickedCommand}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid ColumnDefinitions="* 16 *" RowDefinitions="Auto 16 Auto">
                <Label Grid.Column="0" Grid.Row="0" FontSize="24" Padding="0" Foreground="#FFE9C1">
                    Special
                </Label>

                <Label Grid.Column="2" Grid.Row="0" FontSize="24" Padding="0" Foreground="#FFE9C1">
                    Seasonal
                </Label>

                <ItemsRepeater
                    Grid.Column="0" Grid.Row="2"
                    ItemsSource="{Binding Specials}"
                    VerticalAlignment="Top">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="160"
                            MinItemHeight="100"
                            ItemsStretch="Uniform"
                            MinRowSpacing="16"
                            MinColumnSpacing="16"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:CategoryCard Category="{Binding}" CategoryCommand="{Binding $parent[ItemsRepeater].((vm:CategoriesViewModel)DataContext).CategoryCardClickedCommand}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <ItemsRepeater
                    Grid.Column="2" Grid.Row="2"
                    ItemsSource="{Binding Seasonals}"
                    VerticalAlignment="Top">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="160"
                            MinItemHeight="100"
                            ItemsStretch="Uniform"
                            MinRowSpacing="16"
                            MinColumnSpacing="16"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:CategoryCard Category="{Binding}" CategoryCommand="{Binding $parent[ItemsRepeater].((vm:CategoriesViewModel)DataContext).CategoryCardClickedCommand}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </StackPanel>
    </Border> 
</UserControl>
