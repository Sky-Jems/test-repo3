<UserControl
    x:Class="Pos.Pages.Orders.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pos.Pages.Orders"
    xmlns:controls="using:Pos.Controls"
    xmlns:converters="using:Pos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    x:DataType="app:MainViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:DateTimeConverter x:Key="dateTimeConverter" />
        <converters:EqualsConverter x:Key="equalsConverter" />
        <converters:TextCaseConverter x:Key="textCaseConverter" />
    </UserControl.Resources>

    <SplitView
        Name="orderDetailsPane"
        OpenPaneLength="400"
        PaneBackground="{StaticResource SemiBackground4Color}"
        PanePlacement="Right">
        <SplitView.Pane>
            <!--  OrderDisplayPanel `Width` prevents contents inside the pane from getting squished  -->
            <!--  as the pane resizes when appearing, not moving  -->
            <Panel Width="{Binding #orderDetailsPane.OpenPaneLength}">
                <Canvas>
                    <ToggleSwitch
                        Canvas.Top="20"
                        Canvas.Right="24"
                        Width="24"
                        MinHeight="24"
                        Padding="0"
                        CornerRadius="{StaticResource SemiBorderRadiusFull}"
                        IsChecked="{Binding #orderDetailsPane.IsPaneOpen}"
                        Theme="{DynamicResource ButtonToggleSwitch}">
                        <ToggleSwitch.Styles>
                            <Style Selector="ToggleSwitch:not(:pointerover):not(:pressed)">
                                <Setter Property="Background" Value="{StaticResource ButtonDefaultBackground}" />
                            </Style>
                        </ToggleSwitch.Styles>

                        <ToggleSwitch.Content>
                            <PathIcon
                                Height="12"
                                Data="{DynamicResource SemiIconClose}"
                                Foreground="{StaticResource SemiColorDanger}" />
                        </ToggleSwitch.Content>
                    </ToggleSwitch>
                </Canvas>
                <controls:OrderDisplayPanel
                    DataContext="{Binding OrderDisplayPanelViewModel}"
                    ShowSummaryButton="{Binding $parent.DataContext.ShowOrderCartPanelButton}"
                    SummaryButtonCommand="{Binding $parent.DataContext.AddOrdersButtonCommand}"
                    SummaryButtonText="Manage Order" />
            </Panel>
        </SplitView.Pane>

        <Border Padding="{StaticResource SemiThicknessSuperLoose}">
            <DockPanel VerticalSpacing="{StaticResource SemiSpacingLoose}">
                <Grid
                    Height="{StaticResource SemiHeightControlLarge}"
                    ColumnDefinitions="* auto"
                    DockPanel.Dock="Top">
                    <Label
                        Grid.Column="0"
                        VerticalContentAlignment="Center"
                        Classes="H2"
                        Content="{Binding Status, StringFormat='{}{0} Orders', Converter={StaticResource textCaseConverter}, ConverterParameter=title}"
                        Theme="{StaticResource TitleLabel}" />

                    <Button
                        Name="dateRangeFlyoutButton"
                        Grid.Column="1"
                        Classes="Large"
                        IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderCompleted}}"
                        Theme="{StaticResource SolidButton}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SemiSpacingTight}">
                            <PathIcon Data="{StaticResource SemiIconCalendar}" Theme="{StaticResource InnerPathIcon}" />
                            <StackPanel Orientation="Horizontal">
                                <AccessText Name="startRangeText" Text="Start range" />
                                <AccessText Text=" – " />
                                <AccessText Name="endRangeText" Text="End range" />
                            </StackPanel>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Opened="DateRangeFlyOut_Opened" Placement="BottomEdgeAlignedRight">
                                <Border Padding="12">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <Label Content="From" />
                                            <DatePicker Name="startDatePicker" SelectedDate="{Binding StartDate}" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <Label Content="To" />
                                            <DatePicker
                                                Name="endDatePicker"
                                                IsEnabled="{Binding #startDatePicker.SelectedDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                SelectedDate="{Binding EndDate}" />
                                        </StackPanel>

                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Classes="Large"
                                            Click="ApplyDateFilterButton_Click"
                                            Content="Apply"
                                            IsEnabled="{Binding IsDateFilterable}"
                                            Theme="{StaticResource SolidButton}" />
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid
                    ColumnDefinitions="* *"
                    ColumnSpacing="24"
                    RowDefinitions="auto auto *">
                    <Grid.Styles>
                        <Style Selector="Border.reportCard">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Theme" Value="{StaticResource CardBorder}" />

                            <Style Selector="^ &gt; StackPanel">
                                <Setter Property="Spacing" Value="16" />
                                <Setter Property="Orientation" Value="Horizontal" />
                            </Style>

                            <Style Selector="^ Label.reportCardTitle">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{StaticResource SemiColorText2}" />
                            </Style>

                            <Style Selector="^ Label.reportCardDescription">
                                <Setter Property="FontSize" Value="24" />
                                <Setter Property="FontWeight" Value="500" />
                            </Style>
                        </Style>

                        <Style Selector="Border.cardIcon">
                            <Setter Property="Background" Value="{StaticResource SemiColorPrimaryLight}" />
                            <Setter Property="Width" Value="48" />
                            <Setter Property="Height" Value="48" />
                            <Setter Property="Padding" Value="6" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />

                            <Style Selector="^ PathIcon">
                                <Setter Property="Foreground" Value="{StaticResource SemiColorPrimary}" />
                                <Setter Property="Width" Value="16" />
                            </Style>
                        </Style>
                    </Grid.Styles>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Classes="reportCard"
                        IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderCompleted}}">
                        <StackPanel>
                            <Border Classes="cardIcon">
                                <PathIcon Data="{StaticResource SemiIconCheckList}" />
                            </Border>

                            <StackPanel>
                                <Label Classes="reportCardTitle" Content="TOTAL ORDERS" />
                                <Label Classes="reportCardDescription" Content="{Binding OrderTransactions.Count, FallbackValue=0}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Classes="reportCard"
                        IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderCompleted}}">
                        <StackPanel>
                            <Border Classes="cardIcon">
                                <PathIcon Data="{StaticResource SemiIconLineChartStroked}" />
                            </Border>

                            <StackPanel>
                                <Label Classes="reportCardTitle" Content="TOTAL SALES" />
                                <Label Classes="reportCardDescription" Content="{Binding AmountOfSales, StringFormat='₱{0:N2}', FallbackValue=₱0.00}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Height="24"
                        IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderCompleted}}" />

                    <DataGrid
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        CellPointerPressed="DataGrid_CellPointerPressed"
                        IsReadOnly="True"
                        ItemsSource="{Binding OrderTransactions}"
                        PointerReleased="DataGrid_PointerReleased">
                        <DataGrid.Styles>
                            <Style Selector="DataGridRow:pointerover">
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </DataGrid.Styles>

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding OrderId}" Header="No." />
                            <DataGridTextColumn
                                Width="3*"
                                Binding="{Binding Order.Customer}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding Order.LineItems.Count}"
                                Header="Items" />
                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding GrossAmount, StringFormat='₱{00}'}"
                                Header="Subtotal Amount" />
                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding NetAmount, StringFormat='₱{00}'}"
                                Header="Total Amount" />
                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding SafeRemainingAmount, StringFormat='₱{00}'}"
                                Header="Remaining Balance"
                                IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderPending}}" />
                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding PaymentMethodsDisplay}"
                                Header="Payment Method"
                                IsVisible="{Binding Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderCompleted}}" />
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Order.CreatedAt, Converter={StaticResource dateTimeConverter}, ConverterParameter='M/d/yy - h:mm tt', Mode=OneWay}"
                                Header="Date" />
                            <DataGridTemplateColumn
                                Header="none"
                                IsVisible="{Binding $parent.DataContext.Status, Converter={StaticResource equalsConverter}, ConverterParameter={StaticResource OrderPending}}"
                                Tag="Actions">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="32"
                                            Height="32"
                                            Classes="Success"
                                            Click="AddOrdersButton_Click"
                                            Theme="{StaticResource BorderlessButton}">
                                            <PathIcon
                                                Height="16"
                                                Data="{StaticResource SemiIconPlus}"
                                                Theme="{StaticResource InnerPathIcon}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>
    </SplitView>
</UserControl>
