<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="pos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:pos"
    Shell.FlyoutWidth="180"
    Shell.FlyoutBehavior="{OnIdiom Default=Locked}"
    Shell.FlyoutBackgroundColor="{StaticResource CoreForeground}"
    Shell.NavBarIsVisible="false"
    Title="pos">

    <Shell.ItemTemplate>
        <DataTemplate>
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                <Image Source="{Binding FlyoutIcon}" WidthRequest="60" HeightRequest="60"/>
                <Label Text="{Binding Title}" FontFamily="Inter" FontSize="24" HorizontalOptions="Center" TextColor="Yellow" Margin="0,15,0,0"/>
            </StackLayout>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="Transparent"
                Padding="10">
            <Image Source="skybar_logo.png"
                   HeightRequest="180"
                   WidthRequest="140"
                   Margin="0, 0, 0, 40"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Home" Style="{StaticResource HomeFlyout}">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
    </FlyoutItem>
</Shell>
