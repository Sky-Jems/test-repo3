<UserControl
    x:Class="Pos.Dialogs.PaymentMethodDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pos.Dialogs"
    xmlns:converters="using:Pos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1024"
    Padding="0"
    x:DataType="app:PaymentMethodDialogViewModel"
    Background="{StaticResource SemiColorBackground4}"
    ClipToBounds="True"
    CornerRadius="{StaticResource SemiBorderRadiusMedium}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:EqualsConverter x:Key="equalsConverter" />
        <converters:StringEqualsConverter x:Key="stringEqualsConverter" />
        <converters:StringNotEmptyConverter x:Key="stringNotEmptyConverter" />
        <converters:TextCaseConverter x:Key="textCaseConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="RadioButton">
            <Setter Property="Height" Value="50" />

            <Style Selector="^ &gt; StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="10" />
            </Style>

            <Style Selector="^ Svg">
                <Setter Property="Height" Value="20" />
            </Style>

            <Style Selector="^ AccessText">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style Selector="^:checked AccessText">
                <Setter Property="FontWeight" Value="{StaticResource SemiFontWeightBold}" />
            </Style>

            <Style Selector="^[Tag=cash]:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SemiGreen0Color}" />
                <Setter Property="Foreground" Value="{StaticResource SemiGreen5Color}" />
                <Setter Property="BorderBrush" Value="{StaticResource SemiGreen5Color}" />
            </Style>
            <Style Selector="^[Tag=card]:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SemiOrange0Color}" />
                <Setter Property="Foreground" Value="{StaticResource SemiOrange5Color}" />
                <Setter Property="BorderBrush" Value="{StaticResource SemiOrange5Color}" />
            </Style>
            <Style Selector="^[Tag=gcash]:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SemiBlue0Color}" />
                <Setter Property="Foreground" Value="{StaticResource SemiBlue5Color}" />
                <Setter Property="BorderBrush" Value="{StaticResource SemiBlue5Color}" />
            </Style>
            <Style Selector="^[Tag=voucher]:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SemiViolet0Color}" />
                <Setter Property="Foreground" Value="{StaticResource SemiViolet5Color}" />
                <Setter Property="BorderBrush" Value="{StaticResource SemiViolet5Color}" />
            </Style>
        </Style>

        <Style Selector="Border#SummaryContainer">
            <Style Selector="^ Label.title">
                <Setter Property="Foreground" Value="{StaticResource SemiColorText2}" />
            </Style>
        </Style>

        <Style Selector="ItemsControl#PaymentHistoryItemsControl">
            <Style Selector="^ Svg.cash">
                <Setter Property="Path" Value="avares://pos/Assets/Icons/banknote.svg" />
            </Style>
            <Style Selector="^ Svg.card">
                <Setter Property="Path" Value="avares://pos/Assets/Icons/credit-card.svg" />
            </Style>
            <Style Selector="^ Svg.gcash">
                <Setter Property="Path" Value="avares://pos/Assets/Icons/gcash.svg" />
            </Style>
            <Style Selector="^ Svg.voucher">
                <Setter Property="Path" Value="avares://pos/Assets/Icons/ticket-percent.svg" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="auto * auto">
        <Border
            Grid.Row="0"
            Padding="{StaticResource SemiThicknessBaseLoose}"
            BorderBrush="{StaticResource SemiColorBorder}"
            BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,56,0"
                    Spacing="{StaticResource SemiSpacingExtraTight}">
                    <Label
                        Classes="H4"
                        Content="Payment"
                        Theme="{StaticResource TitleLabel}" />
                    <Label Content="Choose your payment method and complete the transaction." Foreground="{StaticResource SemiColorText2}" />
                </StackPanel>

                <Canvas VerticalAlignment="Stretch" DockPanel.Dock="Top">
                    <Button
                        Canvas.Top="0"
                        Canvas.Right="0"
                        Width="24"
                        MinHeight="24"
                        Padding="0"
                        Classes="Danger"
                        Click="CloseDialog"
                        CornerRadius="{StaticResource SemiBorderRadiusFull}">
                        <PathIcon Height="12" Data="{DynamicResource SemiIconClose}" />
                    </Button>
                </Canvas>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Border Name="SummaryContainer" Padding="{StaticResource SemiThicknessBaseLoose}">
                <Grid
                    ColumnDefinitions="*, *"
                    ColumnSpacing="{StaticResource SemiSpacingBaseLoose}"
                    RowDefinitions="auto auto"
                    RowSpacing="{StaticResource SemiSpacingExtraLoose}">
                    <!--  order summary  -->
                    <DockPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalSpacing="{StaticResource SemiSpacingBaseTight}">
                        <Label
                            Classes="H6"
                            Content="Order Summary"
                            DockPanel.Dock="Top"
                            Theme="{StaticResource TitleLabel}" />
                        <Border
                            Margin="0"
                            Padding="{StaticResource SemiThicknessBase}"
                            VerticalAlignment="Stretch"
                            Background="{StaticResource SemiColorPrimaryLight}"
                            BorderBrush="Transparent"
                            Theme="{StaticResource CardBorder}">
                            <StackPanel
                                Margin="0,-2"
                                VerticalAlignment="Stretch"
                                Spacing="8">
                                <Grid
                                    ColumnDefinitions="Auto,Auto,*,Auto"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                    ColumnSpacing="12"
                                    VerticalAlignment="Center"
                                    RowSpacing="{StaticResource SemiSpacingBaseTight}">

                                    <!-- Row 0 -->
                                    <Label Grid.Row="0" Grid.Column="0" Classes="title" Content="Customer" Margin="0, 12, 0, 0" />
                                    <Label Grid.Row="0" Grid.Column="1" Classes="description" Content="{Binding Customer}" Margin="0, 12, 0, 0" />

                                    <Label Grid.Row="0" Grid.Column="2" Classes="title" HorizontalAlignment="Right" Content="Total Items" Margin="0, 12, 0, 0" />
                                    <Label Grid.Row="0" Grid.Column="3" Classes="description" HorizontalAlignment="Right" Content="{Binding ItemsCount}" Margin="0, 12, 0, 0" />

                                    <!-- Divider -->
                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="4"
                                               Stroke="{StaticResource SemiColorFill2}"
                                               StrokeDashArray="2,6"
                                               StrokeThickness="1"
                                               Margin="0,12" />

                                    <!-- Row 2 -->
                                    <Label Grid.Row="2" Grid.Column="0" Classes="title" Content="Subtotal Amount" />
                                    <Label Grid.Row="2" Grid.Column="1" Classes="H6 description" 
                                           Content="{Binding SubTotal, StringFormat='₱{0:N2}'}" />

                                    <Label Grid.Row="2" Grid.Column="2" Classes="title" HorizontalAlignment="Right" Content="Total Amount" />
                                    <Label Grid.Row="2" Grid.Column="3" Classes="H6 description" HorizontalAlignment="Right"
                                           Content="{Binding Total, StringFormat='₱{0:N2}'}" />

                                    <!-- Row 3 -->
                                    <Label Grid.Row="3" Grid.Column="0" Classes="title" Content="Discount" />
                                    <Label Grid.Row="3" Grid.Column="1" Classes="H6 description"
                                           Content="{Binding DiscountAmount, StringFormat='₱{0:N2}'}" />

                                    <Label Grid.Row="3" Grid.Column="2" Classes="title" HorizontalAlignment="Right" Content="Amount Paid" />
                                    <Label Grid.Row="3" Grid.Column="3" Classes="H6 description" HorizontalAlignment="Right"
                                           Content="{Binding AmountPaid, StringFormat='₱{0:N2}'}"
                                           Foreground="{StaticResource SemiGreen5Color}" />

                                    <!-- Divider -->
                                    <Rectangle Grid.Row="4" Grid.ColumnSpan="4"
                                               Stroke="{StaticResource SemiColorFill2}"
                                               StrokeDashArray="2,6"
                                               StrokeThickness="1"
                                               Margin="0,12" />
                                </Grid>

                                <!-- Separate Grid for Remaining Balance -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                    <Label Grid.Column="0"
                                           Content="Remaining Balance"
                                           FontSize="{StaticResource SemiFontSizeHeader5}"
                                           Theme="{StaticResource TitleLabel}"
                                           HorizontalAlignment="Right" />

                                    <Label Grid.Column="1"
                                           Content="{Binding RemainingBalance, StringFormat='₱{0:N2}'}"
                                           FontSize="{StaticResource SemiFontSizeHeader5}"
                                           Foreground="{StaticResource SemiRed6Color}"
                                           Theme="{StaticResource TitleLabel}"
                                           HorizontalAlignment="Right"
                                           Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!--  payment method  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="{StaticResource SemiSpacingBaseTight}">
                        <Label
                            Classes="H6"
                            Content="Payment Method"
                            Theme="{StaticResource TitleLabel}" />

                        <StackPanel Spacing="{StaticResource SemiSpacingBaseLoose}">
                            <UniformGrid ColumnSpacing="{StaticResource SemiSpacingTight}" RowSpacing="{StaticResource SemiSpacingTight}">
                                <RadioButton
                                    IsChecked="{Binding PaymentMethod, Mode=TwoWay, Converter={StaticResource stringEqualsConverter}, ConverterParameter=cash}"
                                    Tag="cash"
                                    Theme="{DynamicResource PureCardRadioButton}">
                                    <StackPanel>
                                        <Svg Path="avares://pos/Assets/Icons/banknote.svg" />
                                        <AccessText Text="Cash" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    IsChecked="{Binding PaymentMethod, Mode=TwoWay, Converter={StaticResource stringEqualsConverter}, ConverterParameter=gcash}"
                                    Tag="gcash"
                                    Theme="{DynamicResource PureCardRadioButton}">
                                    <StackPanel>
                                        <Svg Path="avares://pos/Assets/Icons/gcash.svg" />
                                        <AccessText Text="Gcash" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    IsChecked="{Binding PaymentMethod, Mode=TwoWay, Converter={StaticResource stringEqualsConverter}, ConverterParameter=card}"
                                    Tag="card"
                                    Theme="{DynamicResource PureCardRadioButton}">
                                    <StackPanel>
                                        <Svg Path="avares://pos/Assets/Icons/credit-card.svg" />
                                        <AccessText Text="Card" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    IsChecked="{Binding PaymentMethod, Mode=TwoWay, Converter={StaticResource stringEqualsConverter}, ConverterParameter=voucher}"
                                    Tag="voucher"
                                    Theme="{DynamicResource PureCardRadioButton}">
                                    <StackPanel>
                                        <Svg Path="avares://pos/Assets/Icons/ticket-percent.svg" />
                                        <AccessText Text="Voucher" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <Grid ColumnDefinitions="* *" ColumnSpacing="{StaticResource SemiSpacingTight}">
                                <StackPanel Grid.Column="0" Spacing="{StaticResource SemiSpacingTight}">
                                    <Label Content="Payment Amount" />
                                    <TextBox
                                        Name="PriceTextBox"
                                        Classes="Large Bordered"
                                        InnerLeftContent="₱"
                                        Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Watermark="0.00" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource SemiSpacingTight}">
                                    <Label Content="{Binding NoteLabel}" />
                                    <TextBox
                                        Name="referenceSection"
                                        Classes="Large Bordered"
                                        InnerLeftContent="{Binding NotePrefix}"
                                        IsVisible="True"
                                        Text="{Binding Notes, Mode=TwoWay}"
                                        Watermark="{Binding NoteWatermark}" />
                                </StackPanel>
                            </Grid>

                            <Panel>
                                <Button
                                    Name="confirmButton"
                                    HorizontalAlignment="Stretch"
                                    Classes="Large Success"
                                    Click="ConfirmButton_Click"
                                    IsEnabled="True"
                                    IsVisible="{Binding CanCompletePayment}"
                                    Theme="{StaticResource SolidButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SemiSpacingTight}">
                                        <PathIcon Data="{StaticResource SemiIconTickCircle}" Theme="{StaticResource InnerPathIcon}" />
                                        <AccessText Text="Complete payment" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Classes="Large"
                                    Command="{Binding AddPaymentCommand}"
                                    IsVisible="{Binding CanAddPayment}"
                                    Theme="{StaticResource SolidButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SemiSpacingTight}">
                                        <PathIcon Data="{StaticResource SemiIconPlus}" Theme="{StaticResource InnerPathIcon}" />
                                        <AccessText Text="Add payment" />
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </StackPanel>

                    <!--  payment history  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="{StaticResource SemiSpacingBaseTight}">
                        <Label
                            Classes="H6"
                            Content="Payment History"
                            Theme="{StaticResource TitleLabel}" />

                        <ItemsControl Name="PaymentHistoryItemsControl" ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid
                                        ColumnSpacing="{StaticResource SemiSpacingTight}"
                                        Columns="4"
                                        RowSpacing="{StaticResource SemiSpacingTight}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="50"
                                        Margin="0"
                                        Padding="16,8"
                                        Theme="{StaticResource CardBorder}">
                                        <Grid
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            ColumnDefinitions="auto * auto"
                                            ColumnSpacing="12">
                                            <Svg
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Height="20"
                                                Classes.card="{Binding PaymentMethod, Converter={StaticResource equalsConverter}, ConverterParameter='card'}"
                                                Classes.cash="{Binding PaymentMethod, Converter={StaticResource equalsConverter}, ConverterParameter='cash'}"
                                                Classes.gcash="{Binding PaymentMethod, Converter={StaticResource equalsConverter}, ConverterParameter='gcash'}"
                                                Classes.voucher="{Binding PaymentMethod, Converter={StaticResource equalsConverter}, ConverterParameter='voucher'}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PaymentMethod, Converter={StaticResource textCaseConverter}, ConverterParameter=title}" />
                                                <ContentControl IsVisible="{Binding Notes, Converter={StaticResource stringNotEmptyConverter}}">
                                                    <TextBlock
                                                        FontSize="{StaticResource SemiFontSizeSmall}"
                                                        Foreground="{StaticResource SemiColorText2}"
                                                        Text="{Binding Notes}" />
                                                </ContentControl>
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource SemiGreen5Color}"
                                                Text="{Binding Amount, StringFormat=₱{0:F2}}">
                                                <Run Text="{Binding PaymentMethod}" />
                                                <LineBreak />
                                                <Run
                                                    FontSize="{StaticResource SemiFontSizeSmall}"
                                                    Foreground="{StaticResource SemiColorText2}"
                                                    Text="{Binding Amount, StringFormat=₱{0:F2}}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
