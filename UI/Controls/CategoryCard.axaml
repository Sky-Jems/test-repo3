<UserControl
    x:Class="Pos.Controls.CategoryCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:CompileBindings="False"
    mc:Ignorable="d">
    <!--  <Button  -->
    <!--  Background="{Binding BgColor}"  -->
    <!--  VerticalAlignment="Stretch"  -->
    <!--  HorizontalAlignment="Stretch"  -->
    <!--  Padding="12"  -->
    <!--  Click="OnButtonClick"  -->
    <!--  CornerRadius="6">  -->
    <!--     <Button.DataContext> -->
    <!--         <Binding Path="$parent.Category"/> -->
    <!--     </Button.DataContext> -->
    <!--    -->
    <!--     <Viewbox HorizontalAlignment="Left"> -->
    <!--         <StackPanel HorizontalAlignment="Left"> -->
    <!--  <Svg  -->
    <!--  Css="{Binding IconColor}"  -->
    <!--  MaxHeight="30"  -->
    <!--  HorizontalAlignment="Left"  -->
    <!--  Path="{Binding Icon}" />  -->
    <!--  <Label  -->
    <!--  Foreground="{Binding FgColor}"  -->
    <!--  FontSize="16"  -->
    <!--  Content="{Binding Name}"/>  -->
    <!--         </StackPanel> -->
    <!--     </Viewbox> -->
    <!-- </Button> -->
    <Button
        Padding="24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Click="OnButtonClick"
        Theme="{StaticResource SolidButton}">
        <Button.DataContext>
            <Binding Path="$parent.SubCategory" />
        </Button.DataContext>

        <Viewbox HorizontalAlignment="Left">
            <StackPanel HorizontalAlignment="Left">
                <Svg
                    MaxHeight="30"
                    HorizontalAlignment="Left"
                    Css="{Binding IconColor}"
                    Path="{Binding Icon}" />
                <AccessText FontSize="16" Text="{Binding Name}" />
            </StackPanel>
        </Viewbox>
    </Button>
</UserControl>
