<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="DataGridCellMinHeight">48</x:Double>
    <Thickness x:Key="DataGridCellTextBlockDefaultMargin">0</Thickness>
    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="Transparent" />

    <CornerRadius x:Key="DataGridRowCornerRadius">2</CornerRadius>
    <Thickness x:Key="DataGridRowMargin">2 2 2 0</Thickness>

    <x:Double x:Key="DataGridColumnHeaderMinHeight">64</x:Double>
    <Thickness x:Key="DataGridColumnHeaderPadding">20 12</Thickness>
</ResourceDictionary>
