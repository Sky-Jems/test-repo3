<UserControl
  x:Class="pos.Dialogs.DetailedCategoryDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Pos.Dialogs"
  Width="500"
  Padding="{StaticResource SemiThicknessLoose}"
  x:DataType="vm:DetailedCategoryDialogViewModel"
  Background="{StaticResource SemiColorBackground4}"
  ClipToBounds="True"
  CornerRadius="{StaticResource SemiBorderRadiusMedium}">
  <StackPanel Spacing="16">
    <Label
      HorizontalAlignment="Center"
      Classes="H5"
      Content="Detailed View"
      Theme="{StaticResource TitleLabel}" />
    <Border Theme="{StaticResource CardBorder}">
      <StackPanel>
        <Label
          Content="Name:"
          FontSize="{StaticResource SemiFontSizeSmall}"
          Foreground="{StaticResource SemiColorText2}" />
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
