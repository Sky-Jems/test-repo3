<UserControl
    x:Class="Pos.Controls.OrderCartPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Pos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pos.Controls"
    x:Name="root"
    x:DataType="vm:OrderCartPanelViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:IsZeroConverter x:Key="isZeroConverter" />
        <converters:IsGreaterThanZeroConverter x:Key="isGreaterThanZeroConverter" />
    </UserControl.Resources>

    <DockPanel>
        <!--  customer name  -->
        <Grid
            Margin="24,24,24,0"
            HorizontalAlignment="Stretch"
            ColumnSpacing="12"
            DockPanel.Dock="Top">
            <TextBox
                Classes="Large Bordered"
                Text="{Binding Customer, Mode=TwoWay}"
                Watermark="Enter customer name" />
            <!--  <Button  -->
            <!--  Grid.Column="1"  -->
            <!--  Content="Save"  -->
            <!--  IsVisible="{Binding IsEditable, ElementName=root}"  -->
            <!--  Theme="{StaticResource OutlineButton}" />  -->
        </Grid>

        <Grid Grid.Column="0" RowDefinitions="auto * auto">
            <!--  header  -->
            <Border Grid.Row="0" Padding="24,24,24,0">
                <Grid ColumnDefinitions="* auto">
                    <Label
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Classes="H4"
                        Content="Order Items"
                        Theme="{StaticResource TitleLabel}" />
                    <Button
                        Grid.Column="1"
                        Classes="Danger"
                        Click="OnClearButtonClick"
                        Content="Clear"
                        IsVisible="{Binding IsEditable, ElementName=root}"
                        Theme="{StaticResource OutlineButton}" />
                </Grid>
            </Border>

            <!--  order list  -->
            <Border
                Grid.Row="1"
                Margin="24,16"
                ClipToBounds="True"
                CornerRadius="4">
                <Grid>
                    <ScrollViewer IsVisible="{Binding OrderList.Count, Converter={StaticResource isGreaterThanZeroConverter}}">
                        <ListBox
                            IsHitTestVisible="{Binding IsEditable, ElementName=root}"
                            ItemsSource="{Binding OrderList}"
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                            Theme="{StaticResource PureCardRadioGroupListBox}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="16 12 16 12" />
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="Transparent"
                                        PointerPressed="CartItem_PointerPressed"
                                        Tag="{Binding}">
                                        <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                                            <Grid
                                                HorizontalAlignment="Stretch"
                                                ColumnDefinitions="* auto"
                                                ColumnSpacing="8">
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Regular"
                                                    Theme="{StaticResource TitleLabel}">
                                                    <Label.Content>
                                                        <MultiBinding StringFormat="{}{0} - {1}">
                                                            <Binding Path="ProductName" />
                                                            <Binding Path="ProductDescription" />
                                                        </MultiBinding>
                                                    </Label.Content>
                                                </Label>
                                                <Button
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Width="32"
                                                    Margin="0,0,-4,0"
                                                    Classes="Danger"
                                                    Click="OnRemoveLineItemButtonClick"
                                                    IsVisible="{Binding IsEditable, ElementName=root}"
                                                    Tag="{Binding}"
                                                    Theme="{StaticResource BorderlessButton}">
                                                    <PathIcon
                                                        Height="16"
                                                        Data="{StaticResource SemiIconCrossStroked}"
                                                        Theme="{StaticResource InnerPathIcon}" />
                                                </Button>
                                            </Grid>

                                            <Grid ColumnDefinitions="* auto" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    Content="{Binding Price, StringFormat='₱{0:N2}'}"
                                                    FontSize="12"
                                                    Opacity="0.6"
                                                    Theme="{StaticResource TitleLabel}" />
                                                <Label
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Classes="Circle Indigo"
                                                    Content="{Binding Quantity, StringFormat='{}{0}x'}"
                                                    IsVisible="{Binding IsQuantityVisible}"
                                                    Theme="{StaticResource TagLabel}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </ScrollViewer>

                    <!--  Zero state message  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="Gray"
                        IsVisible="{Binding OrderList.Count, Converter={StaticResource isZeroConverter}}"
                        Text="No items yet. To add items, start by selecting a service and then choose a product."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  summary  -->
            <Border
                Grid.Row="2"
                Padding="24"
                Background="{StaticResource SemiColorPrimaryLight}"
                CornerRadius="6 6 0 0">
                <StackPanel Spacing="16">
                    <StackPanel.Styles>
                        <Style Selector="Label">
                            <Style Selector="^.price">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </Style>
                    </StackPanel.Styles>

                    <Button
                        HorizontalAlignment="Stretch"
                        Click="ApplyDiscountButton_Click"
                        IsVisible="{Binding IsEditable, ElementName=root}"
                        Theme="{StaticResource OutlineButton}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource SemiIconPlus}" Theme="{StaticResource InnerPathIcon}" />
                            <AccessText Text="Apply Discount" />
                        </StackPanel>
                    </Button>

                    <Rectangle
                        IsVisible="{Binding IsEditable, ElementName=root}"
                        Stroke="{StaticResource SemiColorFill2}"
                        StrokeDashArray="2,6"
                        StrokeThickness="1" />

                    <UniformGrid Columns="2" RowSpacing="6">
                        <Label Content="Subtotal" />
                        <Label Classes="price" Content="{Binding CartTotal, StringFormat='₱{0:N2}'}" />

                        <Label Content="Discount" />
                        <Label Classes="price" Content="₱0.00" />
                    </UniformGrid>

                    <Rectangle
                        Stroke="{StaticResource SemiColorFill2}"
                        StrokeDashArray="2,6"
                        StrokeThickness="1" />

                    <UniformGrid Rows="1">
                        <Label
                            HorizontalAlignment="Stretch"
                            Classes="H5"
                            Content="Total"
                            Theme="{StaticResource TitleLabel}" />
                        <Label
                            Classes="price H5"
                            Content="{Binding CartTotal, StringFormat='₱{0:N2}'}"
                            Theme="{StaticResource TitleLabel}" />
                    </UniformGrid>

                    <UniformGrid
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="12"
                        IsVisible="{Binding ShowButtons, ElementName=root}"
                        Rows="1">
                        <Button
                            HorizontalAlignment="Stretch"
                            Classes="Large"
                            Command="{Binding SummaryButtonCommand, ElementName=root}"
                            Content="{Binding SummaryButtonText, ElementName=root}"
                            Theme="{StaticResource SolidButton}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Classes="Large"
                            Click="OnPayLaterButtonClick"
                            Content="Pay Later"
                            IsVisible="{Binding IsEditable, ElementName=root}"
                            Theme="{StaticResource SolidButton}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
