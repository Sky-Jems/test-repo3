<UserControl
    x:Class="Pos.Pages.Home.Views.Menu.Menu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pos.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Pos.Pages.Home.Views.Menu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MenuViewModel"
    mc:Ignorable="d">

    <Border Padding="24" Background="#101C24">
        <StackPanel Spacing="12">
            <StackPanel
                Margin="0,0,0,32"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <Button
                    Width="60"
                    Height="60"
                    CornerRadius="6"
                    Command="{Binding GoBack}">
                    <Svg Width="21" Path="avares://pos/Assets/Images/back_arrow.svg" />
                </Button>
                <Label
                    Height="60"
                    Margin="10,0,0,0"
                    VerticalContentAlignment="Center"
                    FontSize="34"
                    Foreground="#FFE9C1">
                    MENU
                </Label>
            </StackPanel>

            <Label
                Margin="0,0,0,0"
                Padding=""
                FontSize="24"
                Foreground="#FFE9C1">
                Items
            </Label>

            <ItemsRepeater
                Margin="0,0,0,20"
                VerticalAlignment="Top"
                ItemsSource="{Binding Items}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Uniform"
                        MinColumnSpacing="16"
                        MinItemHeight="100"
                        MinItemWidth="160"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <controls:MenuItemCard MenuItem="{Binding}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </Border>

</UserControl>
