<UserControl
    x:Class="Pos.Pages.Products.CreateProductView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Pos.Pages.Products"
    xmlns:controls="using:Pos.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Margin="12,0,0,0"
    x:DataType="app:CreateProductViewModel"
    Background="{StaticResource SemiBackground1Color}"
    mc:Ignorable="d">

    <DockPanel>
        <Border Padding="24,24,24,0" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="auto * auto" ColumnSpacing="16">
                <Button
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Command="{Binding GoBack}">
                    <PathIcon
                        Width="16"
                        Data="{StaticResource SemiIconArrowLeft}"
                        Theme="{DynamicResource InnerPathIcon}" />
                </Button>

                <StackPanel
                    x:Name="breadcrumbNavigationPanel"
                    Grid.Column="1"
                    Orientation="Horizontal" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    MinWidth="86"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Classes="Large"
                    Click="NextButton_Click"
                    Content="SUBMIT"
                    CornerRadius="6" />
            </Grid>
        </Border>

        <Carousel
            Name="createProductPagination"
            Grid.Row="1"
            Padding="24">
            <Carousel.PageTransition>
                <CompositePageTransition>
                    <PageSlide
                        Orientation="Horizontal"
                        SlideInEasing="SineEaseOut"
                        SlideOutEasing="SineEaseOut"
                        Duration="0.25" />
                </CompositePageTransition>
            </Carousel.PageTransition>

            <Carousel.Items>
                <StackPanel Orientation="Vertical" Spacing="12">

                    <StackPanel Orientation="Vertical" Spacing="4">
                        <Label Content="Name" />
                        <TextBox
                            x:Name="ProductName"
                            Classes="Large Bordered"
                            Text="{Binding ProductName, Mode=TwoWay}"
                            Watermark="Enter product name" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Spacing="4">
                        <Label Content="Description" />
                        <TextBox
                            x:Name="DescriptionName"
                            Height="100"
                            AcceptsReturn="True"
                            Classes="TextArea Bordered"
                            Text="{Binding DescriptionName, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            Watermark="Enter description name" />
                    </StackPanel>

                    <!-- <StackPanel Orientation="Vertical" Spacing="4">
						<Label Content="Media" />
						<Button
							Padding="32"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							Classes="Primary"
							Click="UploadImageButton_Clicked"
							Theme="{StaticResource OutlineButton}">
							<StackPanel Spacing="6">
								<Svg
									Width="52"
									Css="* { fill: #FFFFFF; }"
									Path="avares://pos/Assets/Images/add_image.svg" />
								<Label FontSize="12">Upload an image</Label>
							</StackPanel>
						</Button>
					</StackPanel>-->

                    <StackPanel Orientation="Vertical" Spacing="4">
                        <Label Content="Category" />

                        <!--  TODO: convert as custom control  -->
                        <Button
                            Padding="4,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="Large"
                            Theme="{StaticResource OutlineButton}">
                            <ItemsControl x:Name="selectedCategoriesItemsControl" ItemsSource="{Binding SelectedCategoryList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Classes="Primary"
                                            Command="{Binding $parent[UserControl].DataContext.RemoveCategoryFromListCommand}"
                                            CommandParameter="{Binding .}"
                                            Theme="{StaticResource SolidButton}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <AccessText Text="{Binding Name}" />
                                                <PathIcon
                                                    Height="16"
                                                    Data="{StaticResource SemiIconClear}"
                                                    Theme="{StaticResource InnerPathIcon}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ListBox
                                        ItemsSource="{Binding CategoryList}"
                                        SelectedItems="{Binding SelectedCategoryList}"
                                        SelectionMode="Multiple,Toggle">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Label Content="{Binding Name}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <Label Content="Price" />
                        <TextBox
                            Name="PriceTextBox"
                            Classes="Large Bordered"
                            Text="{Binding Price}"
                            TextInput="PriceTextBox_TextInput"
                            Watermark="Enter Price" />
                    </StackPanel>
                </StackPanel>
            </Carousel.Items>
        </Carousel>
    </DockPanel>
</UserControl>
