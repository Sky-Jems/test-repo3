<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="DataGridCellMinHeight">52</x:Double>
    <Thickness x:Key="DataGridCellTextBlockDefaultMargin">0</Thickness>
    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="Transparent" />

    <StaticResource x:Key="DataGridRowCornerRadius" ResourceKey="SemiBorderRadiusExtraSmall" />
    <Thickness x:Key="DataGridRowMargin">4 0</Thickness>

    <Thickness x:Key="DataGridColumnHeaderPadding">20 16</Thickness>
    <StaticResource x:Key="DataGridColumnHeaderCornerRadius" ResourceKey="SemiBorderRadiusExtraSmall" />
</ResourceDictionary>
